{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbit",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orbit",
      "database_id": "53d2ce53-5326-47da-95b6-386732c50a9b",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "APP_ENV": "development"
  },
  "env": {
    "production": {
      "name": "orbit",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "orbit",
          "database_id": "53d2ce53-5326-47da-95b6-386732c50a9b",
          "migrations_dir": "drizzle"
        }
      ],
      "send_email": [{ "name": "EMAIL" }]
    }
  }
}
