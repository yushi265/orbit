{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbit-local",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "d1_databases": [{ "binding": "DB", "database_name": "orbit-local", "migrations_dir": "drizzle" }],
  "vars": { "APP_ENV": "local", "ORBIT_STORAGE": "d1" }
}
