{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply orbit --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt package.json tsconfig.json vite.config.ts wrangler.jsonc drizzle.config.ts vitest.config.ts src/styles.css src/env.d.ts src/cloudflare.d.ts src/router.tsx src/components src/db src/lib src/routes src/server src/shared public drizzle",
    "format:check": "oxfmt --check package.json tsconfig.json vite.config.ts wrangler.jsonc drizzle.config.ts vitest.config.ts src/styles.css src/env.d.ts src/cloudflare.d.ts src/router.tsx src/components src/db src/lib src/routes src/server src/shared public drizzle"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.89.0",
    "@tanstack/react-router": "^1.138.0",
    "@tanstack/react-start": "^1.138.0",
    "drizzle-orm": "^0.44.5",
    "jose": "^6.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.6",
    "@cloudflare/workers-types": "^4.20250823.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "drizzle-kit": "^0.31.4",
    "jsdom": "^26.1.0",
    "lefthook": "^1.13.6",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.23.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.32.0"
  }
}
